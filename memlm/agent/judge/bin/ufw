#!/bin/bash
# ufw stand-in: /var/lib/opsd/ufw.enabled (yes|no), /var/lib/opsd/ufw.rules ("<port>[/proto] ALLOW|DENY")
S=/var/lib/opsd; R=$S/ufw.rules; touch $R
en=$(cat $S/ufw.enabled 2>/dev/null || echo no)
log() { echo "$(date +%s) ufw $*" >> $S/actions.log; }
norm() { local r=$1; case $r in ssh|OpenSSH) r=22/tcp;; http) r=80/tcp;; https) r=443/tcp;; esac; [[ $r == */* ]] || r=$r; echo "$r"; }
case $1 in
  status)
    echo "Status: $([ $en = yes ] && echo active || echo inactive)"
    [ $en = yes ] || exit 0
    [ "$2" = verbose ] && { echo "Logging: on (low)"; echo "Default: deny (incoming), allow (outgoing), disabled (routed)"; echo "New profiles: skip"; }
    echo; [ "$2" = numbered ] && printf "     %-26s %-12s %s\n" To Action From || printf "%-26s %-12s %s\n" To Action From
    [ "$2" = numbered ] && printf "     %-26s %-12s %s\n" -- ------ ---- || printf "%-26s %-12s %s\n" -- ------ ----
    i=0; while read -r port action; do i=$((i+1))
      [ "$2" = numbered ] && printf "[%2d] %-26s %-12s %s\n" $i "$port" "$action IN" Anywhere || printf "%-26s %-12s %s\n" "$port" "$action IN" Anywhere
    done < $R;;
  allow|deny|limit)
    a=$(echo $1 | tr a-z A-Z); shift; [ "$1" = in ] && shift
    if [ "$1" = from ]; then r=$(echo "$*" | grep -oE 'port [0-9]+' | awk '{print $2}'); r=${r:-any}; else r=$(norm "$1"); fi
    log $a $r
    grep -qx "$r $a" $R && echo "Skipping adding existing rule" || { echo "$r $a" >> $R; echo "Rule added"; echo "Rule added (v6)"; };;
  delete)
    shift; if [[ $1 =~ ^[0-9]+$ ]]; then sed -i "${1}d" $R; log delete $1; else a=$(echo $1 | tr a-z A-Z); r=$(norm "$2"); sed -i "\#^$r $a\$#d" $R; log delete $r; fi
    echo "Rule deleted";;
  enable) echo yes > $S/ufw.enabled; log enable; echo "Firewall is active and enabled on system startup";;
  disable) echo no > $S/ufw.enabled; log disable; echo "Firewall stopped and disabled on system startup";;
  reload) log reload; echo "Firewall reloaded";;
  app) echo "Available applications:"; echo "  OpenSSH";;
  *) echo "Usage: ufw COMMAND" >&2; exit 1;;
esac
