#!/bin/bash
. /usr/local/lib/opsd/lib.sh
u=; n=20
while [ $# -gt 0 ]; do case $1 in -u|--unit) u=$(unit_name $2); shift;; -u*) u=$(unit_name ${1#-u});; --unit=*) u=$(unit_name ${1#*=});;
  -n|--lines) n=$2; shift;; -n*) n=${1#-n};; --lines=*) n=${1#*=};; esac; shift; done
[[ $n =~ ^[0-9]+$ ]] || n=50
if [ -n "$u" ]; then [ -f $U/$u ] || { echo "-- No entries --"; exit 0; }
  ( . $U/$u; tail -n $n "$LOG" 2>/dev/null | sed "s/^/$(hostname) ${EXEC##*/}[$(pid_of $u)]: /" )
else for f in $U/*; do ( . $f; tail -n 5 "$LOG" 2>/dev/null | sed "s/^/$(hostname) ${EXEC##*/}: /" ); done | sort | tail -n $n; fi
